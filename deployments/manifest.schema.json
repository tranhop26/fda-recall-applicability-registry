{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified GenLayer Studionet deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network",
    "chain_id",
    "rpc_url",
    "deployer",
    "contract_address",
    "case_id",
    "recall_number",
    "source_sha256",
    "deployed_source_sha256",
    "transactions",
    "receipts",
    "readback",
    "verified_public_methods",
    "explorer",
    "tools",
    "generated_at"
  ],
  "properties": {
    "network": {"const": "studionet"},
    "chain_id": {"const": 61999},
    "rpc_url": {"type": "string", "format": "uri"},
    "deployer": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "contract_address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "case_id": {"type": "string"},
    "recall_number": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deployed_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transactions": {"type": "object"},
    "receipts": {"type": "object"},
    "readback": {"type": "object"},
    "supplemental_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "wallet",
          "case_id",
          "recall_number",
          "subject",
          "source_observation",
          "captured_at",
          "transactions",
          "receipts",
          "readback",
          "explorer"
        ],
        "properties": {
          "label": {"type": "string"},
          "wallet": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "case_id": {"type": "string"},
          "recall_number": {"type": "string"},
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonical_json", "sha256"],
            "properties": {
              "canonical_json": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "source_observation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "product_type",
              "recall_number",
              "meta_last_updated",
              "checked_at",
              "max_age_seconds",
              "freshness_result"
            ],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "product_type": {"type": "string"},
              "recall_number": {"type": "string"},
              "meta_last_updated": {"type": "string", "format": "date"},
              "checked_at": {"type": "string", "format": "date-time"},
              "max_age_seconds": {"type": "integer", "minimum": 0},
              "freshness_result": {"enum": ["FRESH", "STALE", "UNAVAILABLE"]}
            }
          },
          "captured_at": {"type": "string", "format": "date-time"},
          "transactions": {"type": "object"},
          "receipts": {"type": "object"},
          "readback": {"type": "object"},
          "explorer": {"type": "object"}
        }
      }
    },
    "verified_public_methods": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "explorer": {"type": "object"},
    "tools": {"type": "object"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
